# =============================================================
# PLAY WAVE — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA comite o .env no repositório.
# =============================================================

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/playwave

# JWT — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_POR_UMA_CHAVE_SECRETA_FORTE_DE_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672/playwave
RABBITMQ_USER=playwave
RABBITMQ_PASSWORD=TROQUE_POR_SENHA_FORTE

# Celery
CELERY_BROKER_URL=amqp://USER:PASSWORD@HOST:5672/playwave
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS — lista separada por vírgulas
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Inicialização do banco (apenas para init_db.py)
ADMIN_INITIAL_EMAIL=admin@suaempresa.com
ADMIN_INITIAL_PASSWORD=TROQUE_ANTES_DE_USAR
OPERATOR_INITIAL_EMAIL=operador@suaempresa.com
OPERATOR_INITIAL_PASSWORD=TROQUE_ANTES_DE_USAR

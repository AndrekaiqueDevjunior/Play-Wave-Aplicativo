# ─────────────────────────────────────────────────────────────────────────────
# Configuração da suíte E2E PlayWave
# Copie para `.env` e ajuste para o seu ambiente.
# ─────────────────────────────────────────────────────────────────────────────

# URL do painel administrativo (Vite dev ou build servido)
WEB_URL=http://127.0.0.1:3100

# URL base da API FastAPI.
# IMPORTANTE: rotas ficam na raiz (ex: /devices, /campaigns, /audio/...),
# auth em /api/auth e o player schedule em /api/v1/player/schedule.
API_URL=http://127.0.0.1:8000

# Credenciais admin (devem existir no banco — ver backend/.env ADMIN_INITIAL_*)
ADMIN_EMAIL=admin@playwave.com
ADMIN_PASSWORD=trocar-pela-senha-real

# Tenant alvo dos testes (opcional). Se admin, pode ficar vazio e o backend
# resolve pelo próprio usuário; alguns testes criam dados sob este tenant.
TENANT_ID=

# Prefixo aplicado em todo dado criado pelos testes, para facilitar limpeza.
TEST_PREFIX=e2e-

# Quando true, os testes de fluxo de player/queue rodam contra a API real
# (exigem backend + Postgres + Redis no ar). Quando false, esses específicos
# são pulados com motivo claro.
RUN_PLAYER_API=true

# Timeout (ms) para esperas de fila/versão/SSE
QUEUE_WAIT_TIMEOUT=15000

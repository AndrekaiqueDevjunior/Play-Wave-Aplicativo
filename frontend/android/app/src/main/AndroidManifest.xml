<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!-- RF01 — autostart como HOME launcher: o Android abre o player
                 automaticamente no boot por ser a "tela inicial", sem depender
                 de RECEIVE_BOOT_COMPLETED nem da restrição de background-launch
                 do Android 10+. Para autostart garantido, defina o PlayWave
                 como app de Início padrão uma vez (Configurações > Apps padrão >
                 App de início) — ou provisione como Device Owner. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- RF01 — Autostart nativo: abre o player automaticamente após o boot,
             removendo a dependência de apps de "auto start" de terceiros.
             Confiável quando o app é Device Owner ou Home/launcher (ver
             BootReceiver para limitações de background-start no Android 10+). -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- SPEC 003 — Device Admin Receiver para provisionamento como Device Owner.
             Necessário para PowerManager.reboot() e DevicePolicyManager.lockNow().
             Provisione via: adb shell dpm set-device-owner com.playwave.player/.PlayWaveDeviceAdminReceiver -->
        <receiver
            android:name=".PlayWaveDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- RF01 — autostart do player após o boot do aparelho. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- SPEC 003 — Necessária para PowerManager.reboot() quando provisionado
         como Device Owner. tools:ignore evita warning do lint (permissão
         protegida — não funciona em apps comuns sem Device Owner / root). -->
    <uses-permission
        android:name="android.permission.REBOOT"
        tools:ignore="ProtectedPermissions" />
</manifest>

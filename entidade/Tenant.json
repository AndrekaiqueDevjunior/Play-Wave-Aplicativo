{
  "name": "Tenant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da empresa cliente"
    },
    "document": {
      "type": "string",
      "description": "CNPJ, CPF, etc."
    },
    "plan": {
      "type": "string",
      "enum": [
        "starter",
        "pro",
        "enterprise"
      ],
      "default": "starter"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "max_devices": {
      "type": "number",
      "default": 10
    },
    "contact_email": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}
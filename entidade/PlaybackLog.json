{
  "name": "PlaybackLog",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "device_name": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "campaign_name": {
      "type": "string"
    },
    "media_id": {
      "type": "string"
    },
    "media_name": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "interrupted",
        "error"
      ],
      "default": "completed"
    }
  },
  "required": [
    "device_id",
    "campaign_id",
    "media_id"
  ]
}